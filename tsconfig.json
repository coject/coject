{
    "compilerOptions": {
        "target": "ES2021",
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "esModuleInterop": true,
        "jsx": "react",
        "lib": [
            "ES2021",
            "DOM",
            "DOM.Iterable"
        ],
        "types": [
            "node"
        ],
        "module": "ESNext",
        "moduleResolution": "node",
        "skipLibCheck": true,
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "outDir": "dist/esm",
        "sourceMap": true,
        "strict": true,
    },
    "include": [
        "resources"
    ]
}